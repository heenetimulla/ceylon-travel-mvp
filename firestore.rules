rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Stage 11A: trusted custom claim, never a client-editable profile role.
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function commonFields() {
      return [
        'uid', 'fullName', 'email', 'phoneNumber', 'city', 'accountType',
        'profilePhotoPath', 'status', 'averageRating', 'completedTripsCount',
        'cancelledTripsCount', 'cancellationRate', 'createdAt', 'updatedAt',
        'ratingsCount', 'ratingStarsTotal', 'cancellationCount',
        'registrationStatus', 'accountStatus', 'applicationRevision'
      ];
    }

    function validCommonFields(data) {
      return data.keys().hasAll(commonFields())
        && data.uid == request.auth.uid
        && data.fullName is string
        && data.email is string && data.email == request.auth.token.get('email', '')
        && data.phoneNumber is string
        && data.phoneNumber.size() > 0
        && data.phoneNumber.matches('.*[0-9].*')
        && data.city is string
        && data.accountType in ['tourist', 'driver']
        && data.status == 'active'
        && data.registrationStatus == 'draft' && data.accountStatus == 'pending_approval'
        && data.applicationRevision is int && data.applicationRevision == 0
        && data.profilePhotoPath == null
        && data.ratingsCount == 0 && data.ratingStarsTotal == 0 && data.cancellationCount == 0
        && data.averageRating == 0
        && data.completedTripsCount == 0
        && data.cancelledTripsCount == 0
        && data.cancellationRate == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validVerification(verification) {
      let fields = [
        'status', 'submittedAt', 'reviewedAt', 'reviewedBy', 'rejectionReason'
      ];
      // Clients can submit verification, but cannot approve themselves.
      return verification is map
        && verification.keys().hasAll(fields)
        && verification.keys().hasOnly(fields)
        && verification.status == 'pending'
        && verification.submittedAt == request.time
        && verification.reviewedAt == null
        && verification.reviewedBy == null
        && verification.rejectionReason == null;
    }

    function validDriverFields(data) {
      let fields = commonFields().concat([
        'vehicleType', 'vehicleNumber', 'operatingArea', 'availableAreas',
        'verification'
      ]);
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.vehicleType in [
          'TukTuk', 'Small Car', 'Sedan Car', 'Van - Highroof',
          'Van - Flatroof', 'SUV', 'Bus'
        ]
        && data.vehicleNumber is string
        && data.operatingArea is string
        && data.availableAreas is string
        && validVerification(data.verification);
    }

    match /users/{userId} {
      // Exact field allowlists prevent clients from adding privileged fields.
      // Server timestamp transforms must resolve to this request's time.
      allow create: if isOwner(userId)
        && validCommonFields(request.resource.data)
        && (
          (request.resource.data.accountType == 'tourist'
            && request.resource.data.keys().hasOnly(commonFields()))
          || (request.resource.data.accountType == 'driver'
            && validDriverFields(request.resource.data))
        );

      allow get: if isOwner(userId);
      // Count queries require list permission; only trusted admins may list profiles.
      // General editing remains disabled. Stage 10 events alone update metrics.
      allow list: if isAdmin();
      allow delete: if false;
      allow update: if isSignedIn() && validProfileEvent(userId, resource.data, request.resource.data);
    }

    // Application fields and immutable versions are exclusively worker-managed.
    function approvedAccountProfile(p) {
      // Missing registrationStatus is a pre-application legacy profile, never a new client create.
      return p.get('registrationStatus', 'approved') == 'approved'
        && p.get('accountStatus', p.status) == 'active'
        && (!('registrationStatus' in p) || p.accountType != 'driver' || operationalDriverProfile(p));
    }
    function approvedAccount(uid) {
      return approvedAccountProfile(get(/databases/$(database)/documents/users/$(uid)).data);
    }
    function validApplicationOperation(uid, d) {
      return isSignedIn() && d.keys().hasAll(['actorUid', 'action', 'payload', 'expectedRevision', 'reason', 'status', 'createdAt'])
        && d.keys().hasOnly(['actorUid', 'action', 'payload', 'expectedRevision', 'reason', 'status', 'createdAt'])
        && d.actorUid == request.auth.uid && d.status == 'pending' && d.createdAt == request.time
        && d.expectedRevision is int && d.expectedRevision >= 0
        && d.reason is string && d.reason.size() <= 500 && d.payload is map
        && ((isOwner(uid) && d.action == 'submit_application'
          && get(/databases/$(database)/documents/users/$(uid)).data.registrationStatus in ['draft', 'correction_required', 'rejected']
          && d.payload.keys().hasAll(['profile', 'nicNumber', 'evidence', 'agreementVersion', 'agreementAccepted'])
          && d.payload.keys().hasOnly(['profile', 'nicNumber', 'drivingLicenceNumber', 'evidence', 'agreementVersion', 'agreementAccepted'])
          && d.payload.agreementVersion == '1.0' && d.payload.agreementAccepted == true
          && d.payload.profile is map && d.payload.profile.keys().hasOnly(['fullName', 'phoneNumber', 'city', 'vehicleType', 'vehicleNumber', 'operatingArea', 'availableAreas'])
          && d.payload.nicNumber is string && d.payload.nicNumber.size() <= 40
          && (!('drivingLicenceNumber' in d.payload) || (d.payload.drivingLicenceNumber is string && d.payload.drivingLicenceNumber.size() <= 40))
          && validEvidenceInput(d.payload.evidence))
        || (isAdmin() && d.action in ['approve', 'reject', 'request_correction'] && d.payload.keys().size() == 0
          && (d.action == 'approve' || d.reason.size() > 0)));
    }
    match /users/{uid}/application_operations/{id} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if validApplicationOperation(uid, request.resource.data);
      allow update, delete: if false;
    }
    match /registration_applications/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list, write: if false;
      match /{collection}/{id} {
        allow read: if collection in ['submissions', 'history'] && (isOwner(uid) || isAdmin());
        allow write: if false;
      }
    }

    // Stage 11D: clients may request bounded operations, never apply privileged
    // driver state themselves. The authenticated backend revalidates every action.
    function validEvidenceInput(e) {
      return e is map && e.keys().hasOnly(['nic', 'driving_licence', 'selfie'])
        && (!('nic' in e) || (e.nic is string && e.nic.size() <= 300))
        && (!('driving_licence' in e) || (e.driving_licence is string && e.driving_licence.size() <= 300))
        && (!('selfie' in e) || (e.selfie is string && e.selfie.size() <= 300));
    }
    function validDriverOperation(uid, d) {
      let p = get(/databases/$(database)/documents/users/$(uid)).data;
      return isSignedIn()
        && p.accountType == 'driver'
        && (!('registrationStatus' in p) || (p.registrationStatus == 'approved'
          && !(d.action in ['submit_identity', 'verify_identity', 'reject_identity'])))
        && d.keys().hasAll(['action', 'payload', 'expectedRevision', 'actorUid', 'reason', 'createdAt', 'status'])
        && d.keys().hasOnly(['action', 'payload', 'expectedRevision', 'actorUid', 'reason', 'createdAt', 'status'])
        && d.actorUid == request.auth.uid && d.status == 'pending' && d.createdAt == request.time
        && d.reason is string && d.reason.size() <= 500
        && (d.action != 'reject_payment' || d.reason.size() > 0)
        && d.expectedRevision is int && d.expectedRevision >= 0
        && d.payload is map && d.payload.keys().hasOnly(['nicNumber', 'drivingLicenceNumber',
          'nicDocumentPath', 'drivingLicenceDocumentPath', 'selfiePath', 'paymentId', 'claimedAmountLkr',
          'claimedPaymentDate', 'bankTransactionReference', 'depositorName', 'slipPath', 'bankRecordReference', 'accountStatus', 'evidence'])
        && (!('evidence' in d.payload) || (d.action == 'submit_identity' && validEvidenceInput(d.payload.evidence)))
        && ((isOwner(uid) && d.action in ['submit_identity', 'request_payment', 'submit_payment'])
          || (isAdmin() && d.action in ['verify_identity', 'reject_identity', 'verify_payment',
            'reject_payment', 'activate_membership', 'set_account_status']));
    }
    // One server-created operational event; no client notification mutations.
    match /admin_notifications/{notificationId} {
      allow get: if isAdmin() && notificationId == 'founding_offer_closed';
      allow list, create, update, delete: if false;
    }
    match /driver_verifications/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list, create, update, delete: if false;
      match /submissions/{submissionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }
    match /users/{uid}/payments/{paymentId} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }
    match /users/{uid}/admin_history/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /users/{uid}/driver_operations/{operationId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if validDriverOperation(uid, request.resource.data);
      allow update, delete: if false;
    }
    // identity_registry, payment registries, registration registry and
    // system_config remain server-only under the default deny rule below.
    function operationalDriverProfile(p) {
      return p.accountType == 'driver' && p.get('identityVerificationStatus', '') == 'verified'
        && p.get('registrationStatus', 'approved') == 'approved'
        && p.get('paymentStatus', '') == 'verified' && p.get('membershipStatus', '') == 'active'
        && p.get('accountStatus', '') == 'active'
        && (p.get('membershipPlan', '') == 'founding_lifetime'
          || (p.get('membershipPlan', '') == 'standard_annual'
            && p.get('membershipValidUntil', null) is timestamp && p.membershipValidUntil > request.time));
    }
    function operationalDriver(uid) {
      return operationalDriverProfile(get(/databases/$(database)/documents/users/$(uid)).data);
    }

    function exactTripPostFields(data) {
      let fields = [
        'id', 'creatorId', 'creatorType', 'creatorName', 'postType',
        'postOrigin', 'touristId', 'driverId', 'pickupLocationText',
        'dropLocationText', 'scheduledAt', 'adultsCount', 'kidsCount',
        'baggageCount', 'vehiclePreference', 'notes', 'status',
        'acceptedBidId', 'acceptedDriverId', 'createdAt', 'updatedAt',
        'excludedDriverIds', 'cancellationCount', 'lastCancellationBy',
        'lastCancellationReason', 'lastCancellationAt',
        'tripReference', 'startRequestedAt', 'startAutoStartAt', 'startedAt', 'startMethod',
        'endRequestedAt', 'endAutoCompleteAt', 'endedAt', 'completionMethod'
      ];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function validTripCreatorProfile(data) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profilePath)
        && get(profilePath).data.status == 'active' && approvedAccount(request.auth.uid)
        && get(profilePath).data.accountType in ['tourist', 'driver']
        && data.creatorType == get(profilePath).data.accountType
        && data.creatorName == get(profilePath).data.fullName;
    }

    function validTripIdentity(data, tripId) {
      return data.id is string
        && data.id.size() > 0
        && data.id == tripId
        && data.creatorId == request.auth.uid
        && data.creatorType in ['tourist', 'driver']
        && data.creatorName is string
        && data.creatorName.size() > 0
        && data.creatorName.size() <= 120
        && data.postType == 'trip_request'
        && (
          (data.creatorType == 'tourist'
            && data.touristId == request.auth.uid
            && data.driverId == null
            && data.postOrigin == 'direct')
          || (data.creatorType == 'driver'
            && data.touristId == null
            && data.driverId == request.auth.uid
            && data.postOrigin == 'partner')
        );
    }

    function validTripText(data) {
      return data.pickupLocationText is string
        && data.pickupLocationText.size() > 0
        && data.pickupLocationText.size() <= 200
        && data.dropLocationText is string
        && data.dropLocationText.size() > 0
        && data.dropLocationText.size() <= 200
        && data.notes is string
        && data.notes.size() <= 1000;
    }

    function validTripCounts(data) {
      return data.adultsCount is int
        && data.adultsCount >= 1 && data.adultsCount <= 100
        && data.kidsCount is int
        && data.kidsCount >= 0 && data.kidsCount <= 100
        && data.baggageCount is int
        && data.baggageCount >= 0 && data.baggageCount <= 200;
    }

    function validTripVehicle(data) {
      return data.vehiclePreference in [
        'Any', 'TukTuk', 'Small Car', 'Sedan Car',
        'Van - Highroof', 'Van - Flatroof', 'SUV', 'Bus'
      ];
    }

    function validInitialTripState(data) {
      return data.tripReference is string
        && data.tripReference.matches('^CT-[0-9]{6}-[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}$')
        && data.tripReference != data.id
        && data.startRequestedAt == null && data.startAutoStartAt == null
        && data.startedAt == null && data.startMethod == null
        && data.endRequestedAt == null && data.endAutoCompleteAt == null
        && data.endedAt == null && data.completionMethod == null
        && data.excludedDriverIds == []
        && data.cancellationCount is int
        && data.cancellationCount == 0
        && data.lastCancellationBy == null
        && data.lastCancellationReason == null
        && data.lastCancellationAt == null
        && data.status == 'open'
        && data.acceptedBidId == null
        && data.acceptedDriverId == null
        && data.scheduledAt is timestamp
        && data.scheduledAt > request.time
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasActiveProfile() {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      let profile = get(profilePath).data;
      return exists(profilePath)
        && profile.status == 'active' && approvedAccountProfile(profile)
        && profile.accountType in ['tourist', 'driver'];
    }

    function canListTripPost(data) {
      return hasActiveProfile() && (data.creatorId == request.auth.uid
        || (data.status in ['accepted', 'start_requested', 'in_progress', 'end_requested', 'completed'] && data.acceptedDriverId == request.auth.uid)
        || (hasActiveBidReadProfile('driver') && data.status == 'open'));
    }
    function canGetTripPost(data) { return canListTripPost(data); }

    function isOpenForAcceptance(data) {
      return data.status == 'open'
        && data.acceptedBidId == null
        && data.acceptedDriverId == null
        && data.scheduledAt is timestamp
        && data.scheduledAt > request.time;
    }

    function validTripAcceptance(tripId) {
      let before = resource.data;
      let after = request.resource.data;
      let bidPath = /databases/$(database)/documents/trip_posts/$(tripId)/bids/$(after.acceptedBidId);
      return hasActiveProfile()
        && before.creatorId == request.auth.uid
        && isOpenForAcceptance(before)
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'acceptedBidId', 'acceptedDriverId', 'updatedAt'
        ])
        && after.status == 'accepted'
        && after.acceptedBidId is string && after.acceptedBidId.size() > 0
        && after.acceptedDriverId is string && after.acceptedDriverId.size() > 0
        && after.acceptedDriverId != before.creatorId
        && after.updatedAt == request.time
        && exists(bidPath)
        && get(bidPath).data.status == 'submitted'
        && get(bidPath).data.tripId == tripId
        && get(bidPath).data.driverId == after.acceptedDriverId
        && after.acceptedBidId == after.acceptedDriverId
        && getAfter(bidPath).data.tripId == tripId
        && getAfter(bidPath).data.status == 'accepted'
        && getAfter(bidPath).data.driverId == after.acceptedDriverId
        && getAfter(bidPath).data.updatedAt == request.time;
    }

    // Exclusive routing by current and requested state only. A selected
    // validator's false result is final; never try another operation's validator.
    // Field allowlists and all authorization remain inside the full validators.
    function validTripParentUpdate(tripId, before, after) {
      let from = before.get('status', '');
      let to = after.get('status', '');
      return (from == 'accepted' && to == 'start_requested')
        ? validLifecycleUpdate(tripId)
        : (from == 'start_requested' && to == 'in_progress')
          ? validLifecycleUpdate(tripId)
          : (from == 'in_progress' && to == 'end_requested')
            ? validLifecycleUpdate(tripId)
            : (from == 'end_requested' && to == 'completed')
              ? validLifecycleUpdate(tripId)
              : (from == 'open' && to == 'accepted')
                ? validTripAcceptance(tripId)
                : (from == 'accepted' && to in ['open', 'cancelled'])
                  ? validCancellation(tripId, before, after)
                  : (from == 'open' && to == 'cancelled')
                    ? validOpenCreatorCancellation(tripId, before, after)
                    : false;
    }

    match /trip_posts/{tripId} {
      allow create: if isSignedIn()
        && exactTripPostFields(request.resource.data)
        && validTripCreatorProfile(request.resource.data)
        && validTripIdentity(request.resource.data, tripId)
        && validTripText(request.resource.data)
        && validTripCounts(request.resource.data)
        && validTripVehicle(request.resource.data)
        && validInitialTripState(request.resource.data);

      allow get: if isSignedIn() && canGetTripPost(resource.data);
      allow list: if isAdmin() || (isSignedIn() && canListTripPost(resource.data));
      allow update: if isSignedIn()
        && validTripParentUpdate(tripId, resource.data, request.resource.data);
      allow delete: if false;
    }

    function exactBidFields(data) {
      let fields = [
        'id', 'tripId', 'driverId', 'driverName', 'driverRating',
        'completedTrips', 'cancellationRate', 'priceAmount', 'vehicleType',
        'vehicleDetails', 'vehicleNumber', 'estimatedTripMinutes', 'message', 'status',
        'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function validBidDriver(data) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profilePath)
        && operationalDriver(request.auth.uid)
        && get(profilePath).data.status == 'active' && approvedAccount(request.auth.uid)
        && get(profilePath).data.accountType == 'driver'
        && data.driverId == request.auth.uid
        && data.driverName is string
        && data.driverName.size() > 0
        && data.driverName == get(profilePath).data.fullName
        && data.driverRating is number
        && data.driverRating == get(profilePath).data.averageRating
        && data.completedTrips is int
        && data.completedTrips == get(profilePath).data.completedTripsCount
        && data.cancellationRate is number
        && data.cancellationRate == get(profilePath).data.cancellationRate;
    }

    function validBidTrip(tripId) {
      let tripPath = /databases/$(database)/documents/trip_posts/$(tripId);
      return exists(tripPath)
        && get(tripPath).data.status == 'open'
        && get(tripPath).data.creatorId != request.auth.uid
        && !(request.auth.uid in get(tripPath).data.get('excludedDriverIds', []))
        && get(tripPath).data.scheduledAt is timestamp
        && get(tripPath).data.scheduledAt > request.time;
    }

    function validBidOffer(data) {
      return data.priceAmount is int
        && data.priceAmount > 0 && data.priceAmount <= 10000000
        && data.vehicleType in [
          'TukTuk', 'Small Car', 'Sedan Car', 'Van - Highroof',
          'Van - Flatroof', 'SUV', 'Bus'
        ]
        && data.vehicleDetails is string
        && data.vehicleDetails.size() > 0
        && data.vehicleDetails.size() <= 160
        && data.vehicleNumber is string
        && data.vehicleNumber.size() > 0
        && data.vehicleNumber.size() <= 40
        && data.estimatedTripMinutes is int
        && data.estimatedTripMinutes >= 1 && data.estimatedTripMinutes <= 10080
        && data.message is string && data.message.size() <= 500
        && data.status == 'submitted'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasActiveBidReadProfile(accountType) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profilePath)
        && get(profilePath).data.status == 'active' && approvedAccount(request.auth.uid)
        && get(profilePath).data.accountType == accountType;
    }

    function canCreatorReadBids(tripId) {
      let tripPath = /databases/$(database)/documents/trip_posts/$(tripId);
      return hasActiveProfile()
        && exists(tripPath)
        && get(tripPath).data.creatorId == request.auth.uid;
    }

    function canDriverReadOwnBid(bidId, data) {
      return hasActiveBidReadProfile('driver')
        && bidId == request.auth.uid
        && data.driverId == request.auth.uid;
    }

    function validSelectedBidAcceptance(tripId, bidId) {
      let parentPath = /databases/$(database)/documents/trip_posts/$(tripId);
      let parent = get(parentPath).data;
      let afterParent = getAfter(parentPath).data;
      return hasActiveProfile()
        && operationalDriver(bidId)
        && parent.creatorId == request.auth.uid
        && isOpenForAcceptance(parent)
        && resource.data.tripId == tripId
        && resource.data.driverId is string
        && resource.data.driverId.size() > 0
        && resource.data.driverId == bidId
        && resource.data.driverId != parent.creatorId
        && resource.data.status == 'submitted'
        && request.resource.data.status == 'accepted'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ])
        && afterParent.status == 'accepted'
        && afterParent.acceptedBidId == bidId
        && afterParent.acceptedDriverId == resource.data.driverId
        && afterParent.updatedAt == request.time;
    }

    match /trip_posts/{tripId}/bids/{bidId} {
      // Fixed driver UID prevents duplicates; updates require atomic acceptance or cancellation.
      allow create: if isSignedIn()
        && exactBidFields(request.resource.data)
        && request.resource.data.id is string
        && request.resource.data.id == bidId
        && bidId == request.auth.uid
        && request.resource.data.tripId == tripId
        && validBidDriver(request.resource.data)
        && validBidTrip(tripId)
        && validBidOffer(request.resource.data);

      allow get: if isSignedIn()
        && (canCreatorReadBids(tripId)
          || canDriverReadOwnBid(bidId, resource.data));
      // Parent ownership is query-compatible; non-creator drivers cannot list bids.
      allow list: if isSignedIn() && canCreatorReadBids(tripId);
      allow update: if isSignedIn()
        && (validSelectedBidAcceptance(tripId, bidId)
          || validCancelledBid(tripId, bidId));
      allow delete: if false;
    }

    function cancellationReasonLabel(code) {
      return {
        'vehicle_issue': 'Vehicle issue',
        'personal_emergency': 'Personal emergency',
        'scheduling_conflict': 'Scheduling conflict',
        'unable_to_complete_trip': 'Unable to complete trip',
        'plans_changed': 'Plans changed',
        'trip_no_longer_required': 'Trip no longer required',
        'date_or_time_changed': 'Date or time changed',
        'found_another_arrangement': 'Found another arrangement',
        'other': 'Other'
      }[code];
    }

    function validCancellationRecord(data, tripId, before, byDriver) {
      let fields = ['id', 'tripId', 'cancelledByUid', 'cancelledByRole',
        'reasonCode', 'reasonText', 'penaltyApplied', 'previousStatus',
        'resultingStatus', 'cancelledAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.id == before.acceptedBidId && data.tripId == tripId
        && data.cancelledByUid == request.auth.uid
        && data.cancelledByRole == (byDriver ? 'driver' : 'creator')
        && data.reasonCode in (byDriver
          ? ['vehicle_issue', 'personal_emergency', 'scheduling_conflict', 'unable_to_complete_trip', 'other']
          : ['plans_changed', 'trip_no_longer_required', 'date_or_time_changed', 'found_another_arrangement', 'other'])
        && data.reasonText is string && data.reasonText.size() <= 500
        && (data.reasonText == '' || data.reasonText.matches('^\\S([\\s\\S]*\\S)?$'))
        && (data.reasonCode != 'other' || data.reasonText.size() > 0)
        && data.penaltyApplied is bool
        && data.penaltyApplied == (before.scheduledAt - request.time < duration.value(2, 'h'))
        && data.previousStatus == 'accepted'
        && data.resultingStatus == (byDriver ? 'open' : 'cancelled')
        && data.cancelledAt == request.time;
    }

    // Shared reciprocal validation: each of the three writes requires the other
    // two. Missing legacy parent fields get defaults only for this transition.
    function validCancellation(tripId, before, after) {
      let byDriver = before.creatorId != request.auth.uid;
      let bidPath = /databases/$(database)/documents/trip_posts/$(tripId)/bids/$(before.acceptedBidId);
      let historyPath = /databases/$(database)/documents/trip_posts/$(tripId)/cancellations/$(before.acceptedBidId);
      let history = getAfter(historyPath).data;
      let excluded = before.get('excludedDriverIds', []);
      return hasActiveProfile()
        && before.status == 'accepted'
        && before.acceptedBidId is string && before.acceptedBidId.size() > 0
        && before.acceptedDriverId == before.acceptedBidId
        && (byDriver
          ? hasActiveBidReadProfile('driver') && before.acceptedDriverId == request.auth.uid
          : before.creatorId == request.auth.uid)
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'acceptedBidId', 'acceptedDriverId', 'excludedDriverIds',
          'cancellationCount', 'lastCancellationBy', 'lastCancellationReason',
          'lastCancellationAt', 'updatedAt'
        ])
        && after.status == (byDriver ? 'open' : 'cancelled')
        && after.acceptedBidId == null && after.acceptedDriverId == null
        && after.excludedDriverIds is list
        && (byDriver
          ? !(request.auth.uid in excluded)
            && after.excludedDriverIds == excluded.concat([request.auth.uid])
          : after.excludedDriverIds == excluded)
        && after.cancellationCount is int
        && after.cancellationCount == before.get('cancellationCount', 0) + 1
        && after.lastCancellationBy == request.auth.uid
        && after.lastCancellationAt == request.time && after.updatedAt == request.time
        && !exists(historyPath)
        && validCancellationRecord(history, tripId, before, byDriver)
        && after.lastCancellationReason == (history.reasonText == ''
          ? cancellationReasonLabel(history.reasonCode)
          : cancellationReasonLabel(history.reasonCode) + ': ' + history.reasonText)
        && get(bidPath).data.status == 'accepted'
        && get(bidPath).data.tripId == tripId
        && get(bidPath).data.driverId == before.acceptedDriverId
        && getAfter(bidPath).data.status == (byDriver ? 'cancelled' : 'trip_cancelled')
        && getAfter(bidPath).data.updatedAt == request.time
        && getAfter(bidPath).data.diff(get(bidPath).data).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function validCancelledBid(tripId, bidId) {
      let parentPath = /databases/$(database)/documents/trip_posts/$(tripId);
      let before = get(parentPath).data;
      return before.acceptedBidId == bidId
        && validCancellation(tripId, before, getAfter(parentPath).data);
    }

    // Withdrawal of an unassigned post is separate from accepted cancellation.
    // Creator UID cannot be an accepted bid ID on this creator-owned trip.
    function validOpenCreatorCancellation(tripId, before, after) {
      let historyPath = /databases/$(database)/documents/trip_posts/$(tripId)/cancellations/$(before.creatorId);
      let history = getAfter(historyPath).data;
      let fields = ['id', 'tripId', 'cancelledByUid', 'cancelledByRole',
        'reasonCode', 'reasonText', 'penaltyApplied', 'previousStatus',
        'resultingStatus', 'cancelledAt'];
      return hasActiveProfile()
        && before.creatorId == request.auth.uid
        && before.status == 'open'
        && before.acceptedBidId == null && before.acceptedDriverId == null
        && after.status == 'cancelled'
        && after.acceptedBidId == null && after.acceptedDriverId == null
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'lastCancellationBy', 'lastCancellationReason',
          'lastCancellationAt', 'updatedAt'
        ])
        && after.lastCancellationBy == request.auth.uid
        && after.lastCancellationAt == request.time && after.updatedAt == request.time
        && !exists(historyPath)
        && history.keys().hasAll(fields) && history.keys().hasOnly(fields)
        && history.id == before.creatorId && history.tripId == tripId
        && history.cancelledByUid == request.auth.uid
        && history.cancelledByRole == 'creator'
        && history.previousStatus == 'open' && history.resultingStatus == 'cancelled'
        && history.penaltyApplied == false
        && history.cancelledAt == request.time
        && history.reasonCode in ['plans_changed', 'trip_no_longer_required',
          'date_or_time_changed', 'found_another_arrangement', 'other']
        && history.reasonText is string && history.reasonText.size() <= 500
        && (history.reasonText == '' || history.reasonText.matches('^\\S([\\s\\S]*\\S)?$'))
        && (history.reasonCode != 'other' || history.reasonText.size() > 0)
        && after.lastCancellationReason == (history.reasonText == ''
          ? cancellationReasonLabel(history.reasonCode)
          : cancellationReasonLabel(history.reasonCode) + ': ' + history.reasonText);
    }

    match /trip_posts/{tripId}/cancellations/{cancellationId} {
      allow create: if isSignedIn()
        && ((cancellationId == get(/databases/$(database)/documents/trip_posts/$(tripId)).data.acceptedBidId
          && validCancellation(tripId,
            get(/databases/$(database)/documents/trip_posts/$(tripId)).data,
            getAfter(/databases/$(database)/documents/trip_posts/$(tripId)).data))
          || (cancellationId == get(/databases/$(database)/documents/trip_posts/$(tripId)).data.creatorId
            && validOpenCreatorCancellation(tripId,
              get(/databases/$(database)/documents/trip_posts/$(tripId)).data,
              getAfter(/databases/$(database)/documents/trip_posts/$(tripId)).data)));
      allow read: if isSignedIn() && hasActiveProfile()
        && (canCreatorReadBids(tripId)
          || (hasActiveBidReadProfile('driver')
            && (cancellationId == request.auth.uid
              || (resource.data.cancelledByRole == 'driver'
                && resource.data.cancelledByUid == request.auth.uid))));
      allow update, delete: if false;
    }


    function canReadTripChat(t) {
      return isSignedIn() && hasActiveProfile()
        && t.get('acceptedDriverId', null) is string && t.acceptedDriverId.size() > 0
        && t.acceptedDriverId != t.creatorId
        && t.get('acceptedBidId', null) is string && t.acceptedBidId.size() > 0
        && request.auth.uid in [t.creatorId, t.acceptedDriverId]
        && t.status in ['accepted', 'start_requested', 'in_progress', 'end_requested', 'completed', 'cancelled'];
    }
    // Only the recipient can advance their own private read cursor. A cursor
    // references an immutable incoming message in the current assignment.
    match /trip_posts/{tripId}/chat_reads/{uid} {
      function currentParticipant() {
        return isOwner(uid) && canReadTripChat(get(/databases/$(database)/documents/trip_posts/$(tripId)).data);
      }
      function validCursor() {
        let t = getAfter(/databases/$(database)/documents/trip_posts/$(tripId)).data;
        let d = request.resource.data;
        let m = get(/databases/$(database)/documents/trip_posts/$(tripId)/messages/$(d.lastReadMessageId)).data;
        return canReadTripChat(t)
          && d.keys().hasAll(['assignmentDriverId', 'lastReadMessageId', 'lastReadAt', 'updatedAt'])
          && d.keys().hasOnly(['assignmentDriverId', 'lastReadMessageId', 'lastReadAt', 'updatedAt'])
          && d.lastReadMessageId is string && d.lastReadMessageId.size() > 0
          && d.lastReadAt is timestamp
          && d.assignmentDriverId == t.acceptedDriverId
          && m.assignmentDriverId == t.acceptedDriverId
          && m.senderId == (uid == t.creatorId ? t.acceptedDriverId : t.creatorId)
          && d.lastReadAt == m.createdAt && d.updatedAt == request.time;
      }
      allow get: if currentParticipant();
      allow create: if currentParticipant() && validCursor();
      allow update: if currentParticipant() && validCursor()
        && (resource.data.assignmentDriverId != request.resource.data.assignmentDriverId
          || request.resource.data.lastReadAt >= resource.data.lastReadAt);
      allow list, delete: if false;
    }
    match /trip_posts/{tripId}/messages/{messageId} {
      allow list: if canReadAssignmentMessage(
        get(/databases/$(database)/documents/trip_posts/$(tripId)).data, resource.data);
      // Permit only a missing-document lookup for current participants so sends
      // can transactionally check their new ID. Existing messages use assignment ACLs.
      allow get: if exists(/databases/$(database)/documents/trip_posts/$(tripId)/messages/$(messageId))
        ? canReadAssignmentMessage(get(/databases/$(database)/documents/trip_posts/$(tripId)).data, resource.data)
        : canReadTripChat(get(/databases/$(database)/documents/trip_posts/$(tripId)).data);
      allow create: if validTripChatMessage(tripId, messageId);
      allow update, delete: if false;
    }
    function canReadAssignmentMessage(t, d) {
      // Clients cannot forge assignment ownership: creates bind it to the current
      // performing driver, and updates/deletes are denied. Keep parent access intact.
      return isSignedIn() && hasActiveProfile()
        && (request.auth.uid == t.creatorId
          || (canGetTripPost(t) && d.assignmentDriverId == request.auth.uid));
    }
    function validTripChatMessage(tripId, messageId) {
      // Validate the final parent too, including a simultaneous cancellation/completion.
      let t = getAfter(/databases/$(database)/documents/trip_posts/$(tripId)).data;
      let d = request.resource.data;
      let fields = ['id', 'tripId', 'senderId', 'senderRole', 'assignmentDriverId', 'messageType', 'text', 'latitude', 'longitude', 'createdAt'];
      return canReadTripChat(t)
        && t.status in ['accepted', 'start_requested', 'in_progress', 'end_requested']
        && d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && d.id == messageId && d.tripId == tripId && d.senderId == request.auth.uid
        && d.assignmentDriverId == t.acceptedDriverId
        && d.senderRole == (request.auth.uid == t.creatorId ? 'creator' : 'driver')
        && d.createdAt == request.time
        && ((d.messageType == 'text' && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
              && d.text.matches('^\\S([\\s\\S]*\\S)?$') && d.latitude == null && d.longitude == null)
          || (d.messageType == 'location' && d.text == null
              && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
              && d.longitude is number && d.longitude >= -180 && d.longitude <= 180));
    }

    // Stage 10: client manual actions only; timeout writes require trusted Admin SDK.
    // All client time gates use Firestore request.time, not device time.
    function participant(t) {
      return hasActiveProfile() && t.acceptedDriverId is string
        && t.acceptedDriverId != t.creatorId && t.acceptedBidId is string
        && t.acceptedBidId.size() > 0
        && request.auth.uid in [t.creatorId, t.acceptedDriverId];
    }
    function completionEvent(tripId) {
      let path = /databases/$(database)/documents/trip_posts/$(tripId);
      let b = get(path).data;
      let a = getAfter(path).data;
      return participant(b) && b.status == 'end_requested' && a.status == 'completed'
        && a.diff(b).affectedKeys().hasOnly(['status', 'endedAt', 'completionMethod', 'updatedAt'])
        && a.endedAt == request.time && a.updatedAt == request.time
        && a.completionMethod == 'creator_confirmed'
        && request.auth.uid == b.creatorId && request.time < b.endAutoCompleteAt;
    }
    function validRequestTransition(tripId, b, a, start) {
      let phase = start ? 'start' : 'end';
      let anchor = get(/databases/$(database)/documents/trip_posts/$(tripId)/lifecycle_requests/$(phase)).data;
      return request.auth.uid == b.acceptedDriverId
        && anchor.requestedBy == request.auth.uid
        && anchor.createdAt <= request.time
        && request.time - anchor.createdAt <= duration.value(60, 's')
        && (start
          ? b.status == 'accepted' && a.status == 'start_requested'
            && a.diff(b).affectedKeys().hasOnly(['status', 'startRequestedAt', 'startAutoStartAt', 'startedAt', 'startMethod', 'updatedAt'])
            && a.startRequestedAt == anchor.createdAt
            && a.startAutoStartAt == anchor.createdAt + duration.value(3, 'm')
            && a.startedAt == null && a.startMethod == null
          : b.status == 'in_progress' && a.status == 'end_requested'
            && a.diff(b).affectedKeys().hasOnly(['status', 'endRequestedAt', 'endAutoCompleteAt', 'endedAt', 'completionMethod', 'updatedAt'])
            && a.endRequestedAt == anchor.createdAt
            && a.endAutoCompleteAt == anchor.createdAt + duration.value(30, 'm')
            && a.endedAt == null && a.completionMethod == null);
    }
    function completedProfileWritten(uid, tripId) {
      let path = /databases/$(database)/documents/users/$(uid);
      return getAfter(path).data.completedTripsCount == get(path).data.completedTripsCount + 1
        && getAfter(path).data.lastCompletedTripId == tripId;
    }
    function validLifecycleUpdate(tripId) {
      let b = resource.data;
      let a = request.resource.data;
      return participant(b) && a.updatedAt == request.time
        && ((b.status == 'accepted' && validRequestTransition(tripId, b, a, true))
          || (b.status == 'in_progress' && validRequestTransition(tripId, b, a, false))
          || (b.status == 'start_requested' && a.status == 'in_progress'
            && a.diff(b).affectedKeys().hasOnly(['status', 'startedAt', 'startMethod', 'updatedAt'])
            && a.startedAt == request.time
            && a.startMethod == 'creator_confirmed'
            && request.auth.uid == b.creatorId && request.time < b.startAutoStartAt)
          || (completionEvent(tripId)
            && completedProfileWritten(b.creatorId, tripId)
            && completedProfileWritten(b.acceptedDriverId, tripId)));
    }
    match /trip_posts/{tripId}/lifecycle_requests/{phase} {
      allow read: if isSignedIn() && participant(get(/databases/$(database)/documents/trip_posts/$(tripId)).data);
      allow create, update: if isSignedIn()
        && participant(get(/databases/$(database)/documents/trip_posts/$(tripId)).data)
        && request.auth.uid == get(/databases/$(database)/documents/trip_posts/$(tripId)).data.acceptedDriverId
        && ((phase == 'start' && get(/databases/$(database)/documents/trip_posts/$(tripId)).data.status == 'accepted')
          || (phase == 'end' && get(/databases/$(database)/documents/trip_posts/$(tripId)).data.status == 'in_progress'))
        && request.resource.data.keys().hasAll(['requestedBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['requestedBy', 'createdAt'])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }
    function validProfileEvent(uid, b, a) {
      return a.diff(b).affectedKeys().hasAny(['completedTripsCount'])
        ? validCompletionProfile(uid, b, a)
        : a.diff(b).affectedKeys().hasAny(['ratingsCount']) && validRatingProfile(uid, b, a);
    }
    function validCompletionProfile(uid, b, a) {
      let tripId = a.get('lastCompletedTripId', '');
      let trip = get(/databases/$(database)/documents/trip_posts/$(tripId)).data;
      let rep = getAfter(/databases/$(database)/documents/user_reputation/$(uid)).data;
      return completionEvent(tripId) && uid in [trip.creatorId, trip.acceptedDriverId]
        && a.diff(b).affectedKeys().hasOnly(['completedTripsCount', 'lastCompletedTripId'])
        && a.completedTripsCount is int && a.completedTripsCount == b.completedTripsCount + 1
        && rep.completedTripsCount == a.completedTripsCount
        && rep.ratingsCount == b.get('ratingsCount', 0)
        && rep.ratingStarsTotal == b.get('ratingStarsTotal', 0)
        && rep.averageRating == b.averageRating;
    }
    function validRatingRecord(tripId, direction, d) {
      let t = get(/databases/$(database)/documents/trip_posts/$(tripId)).data;
      let creator = request.auth.uid == t.creatorId;
      return participant(t) && t.status == 'completed'
        && direction == (creator ? 'creator_to_driver' : 'driver_to_creator')
        && d.keys().hasAll(['id', 'tripId', 'tripReference', 'ratedByUid', 'ratedUserUid', 'ratedByRole', 'stars', 'comment', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'tripId', 'tripReference', 'ratedByUid', 'ratedUserUid', 'ratedByRole', 'stars', 'comment', 'createdAt', 'updatedAt'])
        && d.id == direction && d.tripId == tripId && d.tripReference == t.get('tripReference', null)
        && d.ratedByUid == request.auth.uid
        && d.ratedUserUid == (creator ? t.acceptedDriverId : t.creatorId)
        && d.ratedByUid != d.ratedUserUid && d.ratedByRole == (creator ? 'creator' : 'driver')
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && d.comment is string && d.comment.size() > 0 && d.comment.size() <= 1000
        && d.comment.matches('^\\S([\\s\\S]*\\S)?$')
        && d.createdAt == request.time && d.updatedAt == request.time;
    }
    function validRatingProfile(uid, b, a) {
      let tripId = a.get('lastRatingTripId', '');
      let direction = a.get('lastRatingDirection', '');
      let path = /databases/$(database)/documents/trip_posts/$(tripId)/ratings/$(direction);
      let rating = getAfter(path).data;
      let rep = getAfter(/databases/$(database)/documents/user_reputation/$(uid)).data;
      return !exists(path) && validRatingRecord(tripId, direction, rating)
        && rating.ratedUserUid == uid
        && a.diff(b).affectedKeys().hasOnly(['averageRating', 'ratingsCount', 'ratingStarsTotal', 'lastRatingTripId', 'lastRatingDirection'])
        && a.ratingsCount is int && a.ratingsCount == b.get('ratingsCount', 0) + 1
        && a.ratingStarsTotal is int && a.ratingStarsTotal == b.get('ratingStarsTotal', 0) + rating.stars
        && a.averageRating == a.ratingStarsTotal * 1.0 / a.ratingsCount
        && rep.completedTripsCount == b.completedTripsCount
        && rep.averageRating == a.averageRating && rep.ratingsCount == a.ratingsCount
        && rep.ratingStarsTotal == a.ratingStarsTotal;
    }
    match /trip_posts/{tripId}/ratings/{direction} {
      allow read: if isSignedIn() && participant(get(/databases/$(database)/documents/trip_posts/$(tripId)).data);
      allow create: if isSignedIn() && validRatingRecord(tripId, direction, request.resource.data)
        && validRatingProfile(request.resource.data.ratedUserUid,
          get(/databases/$(database)/documents/users/$(request.resource.data.ratedUserUid)).data,
          getAfter(/databases/$(database)/documents/users/$(request.resource.data.ratedUserUid)).data);
      allow update, delete: if false;
    }
    // Trusted safe projections only. Private users and original rating access stay unchanged.
    match /user_public_profiles/{uid} {
      allow read: if isSignedIn() && hasActiveProfile();
      allow write: if false;
      match /reviews/{reviewId} {
        allow read: if isSignedIn() && hasActiveProfile()
          && exists(/databases/$(database)/documents/user_public_profiles/$(uid));
        allow write: if false;
      }
    }
    match /user_reputation/{uid} {
      // Public metrics only. Never mirror names, email, phone or verification documents.
      allow read: if isSignedIn() && hasActiveProfile();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['completedTripsCount', 'ratingsCount', 'ratingStarsTotal', 'averageRating', 'cancellationCount', 'cancellationRate'])
        && request.resource.data.keys().hasOnly(['completedTripsCount', 'ratingsCount', 'ratingStarsTotal', 'averageRating', 'cancellationCount', 'cancellationRate'])
        && ((!exists(/databases/$(database)/documents/user_reputation/$(uid))
            && request.resource.data.cancellationCount == null && request.resource.data.cancellationRate == null)
          || (exists(/databases/$(database)/documents/user_reputation/$(uid))
            && request.resource.data.cancellationCount == resource.data.cancellationCount
            && request.resource.data.cancellationRate == resource.data.cancellationRate))
        && validProfileEvent(uid, get(/databases/$(database)/documents/users/$(uid)).data, getAfter(/databases/$(database)/documents/users/$(uid)).data);
      allow delete: if false;
    }

    function supportAdmin() {
      return isSignedIn() && request.auth.token.get('supportAdmin', false) == true;
    }
    function supportOwner(id) {
      return isSignedIn() && get(/databases/$(database)/documents/support_requests/$(id)).data.userId == request.auth.uid;
    }
    function validSupportTrip(d) {
      let t = get(/databases/$(database)/documents/trip_posts/$(d.tripId)).data;
      return t.status == 'completed' && participant(t) && d.category == 'complaint'
        && d.creatorId == t.creatorId && d.acceptedDriverId == t.acceptedDriverId
        && d.tripReference == t.get('tripReference', null)
        && d.subCategory in (request.auth.uid == t.creatorId
          ? ['driver_no_show', 'driver_started_without_passenger', 'wrong_start_time', 'wrong_end_time', 'driver_ended_incorrectly', 'driver_behaviour', 'vehicle_issue', 'safety_concern', 'payment_price_issue', 'other']
          : ['passenger_no_show', 'creator_unreachable', 'incorrect_hire_details', 'wrong_pickup_drop', 'payment_incorrect', 'payment_incomplete', 'passenger_creator_behaviour', 'trip_changed_unexpectedly', 'other']);
    }
    function validSupportCreate(id, d) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let fields = ['id', 'supportReference', 'userId', 'userRole', 'userName', 'contactNumber', 'category', 'subCategory',
        'tripId', 'tripReference', 'creatorId', 'acceptedDriverId', 'subject', 'message', 'status', 'createdAt', 'updatedAt', 'lastMessageAt', 'lastMessageId'];
      return isSignedIn() && profile.accountType in ['tourist', 'driver'] && d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && d.id == id && d.userId == request.auth.uid && d.userRole == profile.accountType && d.userName == profile.fullName
        && d.supportReference is string && d.supportReference.matches('^SUP-[0-9]{6}-[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}$')
        && d.contactNumber is string && d.contactNumber.size() <= 40
        && d.contactNumber.matches('^\\+?[0-9(][0-9 ()-]*[0-9)]$')
        && d.contactNumber.replace('[^0-9]', '').size() >= 7
        && d.contactNumber.replace('[^0-9]', '').size() <= 15
        && d.category in ['complaint', 'feedback', 'suggestion', 'question', 'registration_help', 'app_usage_help', 'other']
        && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 160 && d.subject.matches('^\\S([\\s\\S]*\\S)?$')
        && d.message is string && d.message.size() > 0 && d.message.size() <= 4000 && d.message.matches('^\\S([\\s\\S]*\\S)?$')
        && d.status == 'open' && d.createdAt == request.time && d.updatedAt == request.time && d.lastMessageAt == request.time && d.lastMessageId == null
        && ((d.tripId == null && d.creatorId == null && d.acceptedDriverId == null && d.subCategory == null
            && (d.tripReference == null || (d.category == 'complaint' && d.tripReference is string && d.tripReference.size() > 0 && d.tripReference.size() <= 40)))
          || (d.tripId is string && validSupportTrip(d)));
    }
    function validSupportReply(id, messageId, d) {
      let parentPath = /databases/$(database)/documents/support_requests/$(id);
      let b = get(parentPath).data;
      let a = getAfter(parentPath).data;
      return b.status != 'closed'
        && d.keys().hasAll(['id', 'senderId', 'senderRole', 'message', 'createdAt'])
        && d.keys().hasOnly(['id', 'senderId', 'senderRole', 'message', 'createdAt'])
        && d.id == messageId && d.senderId == request.auth.uid
        && ((b.userId == request.auth.uid && d.senderRole == 'user') || (supportAdmin() && d.senderRole == 'admin'))
        && d.message is string && d.message.size() > 0 && d.message.size() <= 4000 && d.message.matches('^\\S([\\s\\S]*\\S)?$')
        && d.createdAt == request.time && a.updatedAt == request.time && a.lastMessageAt == request.time && a.lastMessageId == messageId
        && a.diff(b).affectedKeys().hasOnly(['updatedAt', 'lastMessageAt', 'lastMessageId']);
    }
    // Stage 11C: every staff status transition has an atomic, immutable audit event.
    function validSupportStatusChange(id, eventId, d) {
      let parentPath = /databases/$(database)/documents/support_requests/$(id);
      let b = get(parentPath).data;
      let a = getAfter(parentPath).data;
      return supportAdmin()
        && d.keys().hasAll(['id', 'actorId', 'fromStatus', 'toStatus', 'createdAt'])
        && d.keys().hasOnly(['id', 'actorId', 'fromStatus', 'toStatus', 'createdAt'])
        && d.id == eventId && d.actorId == request.auth.uid
        && d.fromStatus == b.status && d.toStatus == a.status && d.fromStatus != d.toStatus
        && d.fromStatus in ['open', 'in_review', 'resolved', 'closed']
        && d.toStatus in ['open', 'in_review', 'resolved', 'closed']
        && d.createdAt == request.time && a.updatedAt == request.time
        && a.lastStatusEventId == eventId
        && a.diff(b).affectedKeys().hasOnly(['status', 'updatedAt', 'lastStatusEventId']);
    }
    match /support_requests/{id} {
      allow create: if isSignedIn() && validSupportCreate(id, request.resource.data);
      // Primary admin alone retains parent reads; conversations/writes require supportAdmin.
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || supportAdmin() || isAdmin());
      allow update: if isSignedIn()
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessageAt', 'lastMessageId'])
            && !exists(/databases/$(database)/documents/support_requests/$(id)/messages/$(request.resource.data.lastMessageId))
            && validSupportReply(id, request.resource.data.lastMessageId, getAfter(/databases/$(database)/documents/support_requests/$(id)/messages/$(request.resource.data.lastMessageId)).data))
          || (supportAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'lastStatusEventId'])
            && request.resource.data.lastStatusEventId is string
            && !exists(/databases/$(database)/documents/support_requests/$(id)/status_history/$(request.resource.data.lastStatusEventId))
            && validSupportStatusChange(id, request.resource.data.lastStatusEventId,
              getAfter(/databases/$(database)/documents/support_requests/$(id)/status_history/$(request.resource.data.lastStatusEventId)).data)));
      allow delete: if false;
    }
    match /support_requests/{id}/messages/{messageId} {
      allow read: if supportOwner(id) || supportAdmin();
      allow create: if isSignedIn() && validSupportReply(id, messageId, request.resource.data);
      allow update, delete: if false;
    }
    match /support_requests/{id}/status_history/{eventId} {
      allow read: if supportAdmin();
      allow create: if validSupportStatusChange(id, eventId, request.resource.data);
      allow update, delete: if false;
    }

    // Includes all other collections and any user subcollections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
